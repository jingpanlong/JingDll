<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="景修 DLL · 专业依赖诊断与修复" Width="1240" Height="820" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F4F7FC" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#18243C">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#2463EB"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E9EFFB"/><Setter Property="Foreground" Value="#2D4E82"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AEBBD3"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="15,14"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#DCE4F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AlternatingRowBackground" Value="#FAFCFF"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EEF3FB"/><Setter Property="Foreground" Value="#62738D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E4EAF4"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#72819A"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101D36"><Grid Margin="20,28,20,20"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="85"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#3575FF" Width="38" Height="38" CornerRadius="11" Margin="0,0,10,0"><TextBlock Text="J" FontSize="27" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="景修 DLL" FontSize="21" FontWeight="Bold" Foreground="White"/><TextBlock Text="JING DLL REPAIR" FontSize="9" Foreground="#7E96BB" Margin="1,3,0,0"/></StackPanel></StackPanel><TextBlock Text="依赖有迹可循 · 修复有据可查" FontSize="10" Foreground="#7388AC" Margin="0,19,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="工作空间" FontSize="10" Foreground="#637C9F" Margin="15,0,0,12"/>
    <Button Name="navHome" Content="◈     修复总览" Style="{StaticResource Nav}"/>
    <Button Name="navScan" Content="⌕     程序依赖诊断" Style="{StaticResource Nav}"/>
    <Button Name="navDatabase" Content="▤     DLL 知识数据库" Style="{StaticResource Nav}"/>
    <Button Name="navRuntime" Content="▧     官方运行库" Style="{StaticResource Nav}"/>
    <Button Name="navTools" Content="⚙     Windows 修复" Style="{StaticResource Nav}"/>
    <Button Name="navBackups" Content="↶     备份与回滚" Style="{StaticResource Nav}"/>
    <Button Name="navLogs" Content="≡     操作日志" Style="{StaticResource Nav}"/>
    <Button Name="navAbout" Content="ⓘ     关于与作者" Style="{StaticResource Nav}"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#1C2C49" CornerRadius="9" Padding="13"><StackPanel><TextBlock Text="●  本地诊断 · 按需联网" Foreground="#86D8BD" FontSize="11"/><TextBlock Text="v1.0.0  /  WINDOWS" Foreground="#7288AD" FontSize="10" Margin="0,10,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="67"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E5EAF3" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="系统维护  /  DLL 修复工作台" Foreground="#7988A0" VerticalAlignment="Center"/><TextBlock Name="machineLabel" Text="WINDOWS  ·  本地设备" HorizontalAlignment="Right" Foreground="#59708F" FontSize="11"/></DockPanel></Border>
   <Grid Name="pages" Grid.Row="1" Margin="30,25,30,20">
    <ScrollViewer Name="pageHome" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="让程序，重新顺畅运行。" Style="{StaticResource Title}"/><TextBlock Text="从依赖诊断到可回滚修复，清楚了解每一次改动。" Style="{StaticResource Muted}" Margin="0,0,0,22"/>
     <Border CornerRadius="15" Padding="29" Margin="0,0,0,20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173E91" Offset="0"/><GradientStop Color="#3277F0" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DEPENDENCY HEALTH" FontSize="10" Foreground="#B0D1FF"/><TextBlock Text="先定位原因，再精准修复" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,13,0,10"/><TextBlock Text="选择报错的 EXE 或 DLL，检查缺失依赖、架构与导出函数。" Foreground="#D2E4FF" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Name="homeScan" Content="选择程序并诊断   →" Background="White" Foreground="#1E54BC"/><Button Name="homeInspect" Content="文件详情" Background="#2457B8"/></StackPanel></StackPanel><Border Grid.Column="1" Width="108" Height="108" CornerRadius="30" Background="#3380EB" BorderBrush="#6AA7FF" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="DLL" FontWeight="Bold" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
     <UniformGrid Columns="3" Margin="0,0,-12,22"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="离线知识库 · 版本/架构记录" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Name="statCatalog" Text="加载中" FontWeight="Bold" FontSize="29" Margin="0,8,0,2"/><TextBlock Name="statNames" Foreground="#248E76" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="最近一次 · 依赖疑点" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Name="statIssues" Text="—" FontWeight="Bold" FontSize="29" Margin="0,8,0,2"/><TextBlock Text="选择程序后显示实际结果" Foreground="#7B8CA7" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="应用 DLL · 修复备份" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Name="statBackups" Text="0" FontWeight="Bold" FontSize="29" Margin="0,8,0,2"/><TextBlock Text="SHA-256 校验与回滚保护" Foreground="#7B8CA7" FontSize="11"/></StackPanel></Border></UniformGrid>
     <TextBlock Text="按故障选择处理方式" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/><UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="01   应用启动报错" FontSize="15" FontWeight="Bold"/><TextBlock Text="定位直接导入依赖，核对 x86 / x64 与函数兼容性。" Style="{StaticResource Muted}" Margin="0,10,0,17"/><Button Name="homeDiagnostic" Content="进入依赖诊断 →" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02   系统组件损坏" FontSize="15" FontWeight="Bold"/><TextBlock Text="使用 DISM 与 SFC 检查并恢复 Windows 系统文件。" Style="{StaticResource Muted}" Margin="0,10,0,17"/><Button Name="homeSystem" Content="进入 Windows 修复 →" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border></UniformGrid>
    </StackPanel></ScrollViewer>
    <Grid Name="pageScan" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="程序依赖诊断" Style="{StaticResource Title}"/><TextBlock Text="静态解析直接导入与延迟导入；实际加载还受 SxS、应用清单、API Set 与运行时配置影响。" Style="{StaticResource Muted}" Margin="0,0,0,18"/><DockPanel><Button DockPanel.Dock="Right" Name="browseApp" Content="选择程序" Margin="10,0,0,0"/><TextBox Name="appPath" IsReadOnly="True" Text="请选择需要诊断的 EXE 或 DLL 文件"/></DockPanel></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16"><Button Name="scanAgain" Content="开始诊断"/><Button Name="repairLocal" Content="从可信文件修复选中 DLL" Style="{StaticResource Secondary}"/><Button Name="exportScan" Content="导出报告" Style="{StaticResource Secondary}"/></StackPanel>
     <DataGrid Name="scanGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="DLL / 模块" Binding="{Binding Dll}" Width="2*"/><DataGridTextColumn Header="诊断结果" Binding="{Binding Status}" Width="1.4*"/><DataGridTextColumn Header="架构" Binding="{Binding Arch}" Width="65"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="1.4*"/></DataGrid.Columns></DataGrid>
     <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><TextBox Name="scanDetail" Text="选择一条诊断结果查看候选路径和处理建议。尚未执行扫描。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" Padding="0"/></Border>
    </Grid>
    <Grid Name="pageDatabase" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions><StackPanel><TextBlock Text="DLL 知识数据库" Style="{StaticResource Title}"/><TextBlock Name="catalogInfo" Style="{StaticResource Muted}" Margin="0,0,0,15"/><DockPanel Margin="0,0,0,12"><ComboBox Name="archFilter" DockPanel.Dock="Right" Width="120" Margin="10,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center"><ComboBoxItem Content="全部架构"/><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="ARM64"/><ComboBoxItem Content="未标注"/></ComboBox><TextBox Name="catalogSearch" ToolTip="搜索 DLL 名称、描述、版本或类别"/></DockPanel><DockPanel Margin="0,0,0,12"><Button Name="exportCatalog" Content="导出检索结果" Style="{StaticResource Secondary}" Padding="12,7" DockPanel.Dock="Right"/><TextBlock Name="catalogCount" VerticalAlignment="Center" Foreground="#72819A"/></DockPanel></StackPanel><DataGrid Name="catalogGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="DLL 名称" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="架构" Binding="{Binding Architecture}" Width="65"/><DataGridTextColumn Header="参考版本" Binding="{Binding Version}" Width="1.3*"/><DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14"><TextBox Name="catalogDetail" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" Text="知识库包含真实 Windows 参考元数据，不内置微软 DLL 二进制。相同 DLL 的不同版本、架构分别计数；参考版本不是升级或替换依据。"/></Border></Grid>
    <ScrollViewer Name="pageRuntime" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="官方运行库" Style="{StaticResource Title}"/><TextBlock Text="Visual C++ 从微软官方下载，验证有效签名及微软发布者后启动安装；可能需要管理员授权或重启。" Style="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Microsoft Visual C++ v14" FontSize="20" FontWeight="Bold"/><TextBlock Text="适用于 MSVCP140、VCRUNTIME140、VCRUNTIME140_1 等运行库报错。64 位 Windows 上的 32 位程序也需要 x86 包。" Style="{StaticResource Muted}" Margin="0,12,0,18"/><StackPanel Orientation="Horizontal"><Button Name="installX64" Content="下载并安装 x64"/><Button Name="installX86" Content="下载并安装 x86" Style="{StaticResource Secondary}"/><Button Name="vcDocs" Content="官方说明 ↗" Style="{StaticResource Secondary}"/></StackPanel></StackPanel></Border>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DirectX 旧版组件" FontSize="18" FontWeight="Bold"/><TextBlock Text="D3DX9、XINPUT1_3、XAudio2_7 等问题，按微软说明安装对应组件。" Style="{StaticResource Muted}" Margin="0,12,0,18"/><Button Name="directxDocs" Content="打开微软下载页 ↗" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text=".NET Desktop Runtime" FontSize="18" FontWeight="Bold"/><TextBlock Text="根据应用要求选择 .NET 桌面运行时版本；新版本不能替代所有旧版本。" Style="{StaticResource Muted}" Margin="0,12,0,18"/><Button Name="netDocs" Content="打开官方版本列表 ↗" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><DockPanel><Button Name="refreshRuntime" DockPanel.Dock="Right" Content="刷新本机信息" Style="{StaticResource Secondary}"/><TextBlock Text="本机运行库记录" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/></DockPanel><TextBox Name="runtimeInfo" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer Name="pageTools" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Windows 修复中心" Style="{StaticResource Title}"/><TextBlock Text="调用当前 Windows 内置工具。检查和修复耗时可能较长，执行前会展示命令并请求管理员授权。" Style="{StaticResource Muted}" Margin="0,0,0,20"/><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="01   检查组件存储" FontSize="19" FontWeight="Bold"/><TextBlock Text="DISM /Online /Cleanup-Image /ScanHealth" FontFamily="Consolas" Foreground="#7586A1" Margin="0,12,0,16"/><Button Name="dismCheck" Content="运行 DISM 检查" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="02   修复组件存储与系统文件" FontSize="19" FontWeight="Bold"/><TextBlock Text="先执行 DISM /RestoreHealth，再运行 SFC /scannow。DISM 可能通过 Windows Update 获取组件。" Style="{StaticResource Muted}" Margin="0,12,0,16"/><StackPanel Orientation="Horizontal"><Button Name="systemRepair" Content="运行完整系统修复"/><Button Name="sfcVerify" Content="仅验证系统文件" Style="{StaticResource Secondary}"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="文件工具" FontSize="18" FontWeight="Bold"/><TextBlock Text="读取 PE 架构、版本、数字签名、SHA-256、导入模块与导出数量，不加载执行 DLL。" Style="{StaticResource Muted}" Margin="0,12,0,16"/><StackPanel Orientation="Horizontal"><Button Name="inspectFile" Content="检查 EXE / DLL 文件" Style="{StaticResource Secondary}"/><Button Name="openMaintenance" Content="查看系统任务日志" Style="{StaticResource Secondary}"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
    <Grid Name="pageBackups" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="备份与回滚" Style="{StaticResource Title}"/><TextBlock Text="仅记录本工具的应用私有 DLL 替换。系统修复与运行库安装由 Windows 和官方安装器管理。" Style="{StaticResource Muted}" Margin="0,0,0,18"/><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Name="rollback" Content="回滚选中修复"/><Button Name="refreshBackups" Content="刷新列表" Style="{StaticResource Secondary}"/><Button Name="openData" Content="打开数据目录" Style="{StaticResource Secondary}"/></StackPanel></StackPanel><DataGrid Name="backupGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="操作时间" Binding="{Binding Time}" Width="170"/><DataGridTextColumn Header="目标文件" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="135"/><DataGridCheckBoxColumn Header="已回滚" Binding="{Binding RolledBack}" Width="80"/></DataGrid.Columns></DataGrid></Grid>
    <Grid Name="pageLogs" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="操作日志" Style="{StaticResource Title}"/><TextBlock Text="操作与错误保存在本机；导出日志和诊断报告可能包含本机路径。" Style="{StaticResource Muted}" Margin="0,0,0,18"/><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Name="refreshLogs" Content="刷新日志"/><Button Name="exportLogs" Content="导出日志" Style="{StaticResource Secondary}"/></StackPanel></StackPanel><TextBox Grid.Row="1" Name="logText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas,Microsoft YaHei UI" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid>
    <ScrollViewer Name="pageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="关于景修 DLL" Style="{StaticResource Title}"/><TextBlock Text="看清依赖，让修复更有把握。" Style="{StaticResource Muted}" Margin="0,0,0,22"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="景修 DLL   /   JING DLL REPAIR" FontSize="23" FontWeight="Bold"/><TextBlock Text="版本 1.0.0 · Windows 桌面版" Foreground="#2E67D4" Margin="0,8,0,18"/><TextBlock Text="专注 DLL 缺失、文件异常和架构/函数版本不兼容的诊断与处理。提供真实离线元数据库、PE 依赖分析、官方运行库安装、Windows 系统修复、应用文件备份回滚与完整操作日志。" Style="{StaticResource Muted}"/><TextBlock Text="工具无法保证修复所有程序错误。知识库是 Windows 参考元数据与 Winbindex 历史名称索引，不是 DLL 文件下载站；静态扫描不会覆盖动态 LoadLibrary、托管程序集绑定与所有 Windows 加载器规则。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="联系作者" FontSize="20" FontWeight="Bold"/><TextBlock Text="分享 Windows 实用工具与使用技巧，欢迎关注与反馈。" Style="{StaticResource Muted}" Margin="0,10,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="微信公众号" Foreground="#75849B"/><TextBlock Text="景同志" FontSize="25" FontWeight="Bold" Margin="0,8,0,13"/><Button Name="copyWechat" Content="复制公众号名称" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="小红书" Foreground="#75849B"/><TextBlock Text="景同学" FontSize="25" FontWeight="Bold" Margin="0,8,0,13"/><Button Name="copyRed" Content="复制小红书名称" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="GitHub 开源" Foreground="#75849B"/><TextBlock Text="JingDll" FontSize="25" FontWeight="Bold" Margin="0,8,0,13"/><Button Name="openGithub" Content="访问项目页 / 下载" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/><TextBlock Name="githubUrl" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Grid></StackPanel></Border><TextBlock Text="隐私：本工具不上传扫描文件或日志；仅官方下载和外部说明页需要联网。&#x0a;许可：GPL-3.0；含 Winbindex 名称索引，来源与完整许可见源码。&#x0a;签名：此构建尚未进行商业代码签名。首次启动可能显示 Windows 发布者提示。" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,1,0,0" Padding="25,0"><DockPanel VerticalAlignment="Center"><ProgressBar Name="busyBar" DockPanel.Dock="Right" Width="110" Height="4" Visibility="Collapsed" IsIndeterminate="True"/><TextBlock Name="status" Text="就绪 · 选择程序开始诊断" Foreground="#7888A2" FontSize="11"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
